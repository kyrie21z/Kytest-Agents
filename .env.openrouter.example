# OpenRouter profile. Copy to .env.openrouter and run: python kytest.py <target> --env .env.openrouter
# The key stays outside the repository: put it in a file and point LLM_API_KEY_FILE at it
# (LLM_API_KEY, if set, takes precedence).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_API_KEY_FILE=~/.config/openrouter/api_key
# A reasoning model spends output tokens on reasoning before the answer: leave room.
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=180
# The free tier rate-limits (HTTP 429); retries back off and honour Retry-After.
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
AGENT_MAX_STEPS=12
AGENT_MAX_CONTEXT_CHARS=32000
EXECUTION_MODE=sandbox
ALLOW_WRITE=true
ALLOW_CODE_EXECUTION=true
EXEC_TIMEOUT=10
